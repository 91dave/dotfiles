{
  "askUserQuestionTimeout": "never",
  "autoMemoryEnabled": false,
  "effortLevel": "high",
  "enabledPlugins": {
    "tmux-agent-sidebar@hiroppy": false
  },
  "extraKnownMarketplaces": {
    "hiroppy": {
      "source": {
        "path": "/home/dave/.tmux/plugins/tmux-agent-sidebar",
        "source": "directory"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "bash /mnt/c/Code/_personal/dotfiles/dotfiles/bin/agent-state hook permission",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "permission_prompt"
      },
      {
        "hooks": [
          {
            "command": "bash /mnt/c/Code/_personal/dotfiles/dotfiles/bin/agent-state hook waiting",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "agent_needs_input|elicitation_dialog|elicitation_url_dialog"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash /mnt/c/Code/_personal/dotfiles/dotfiles/bin/agent-state hook working",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash /mnt/c/Code/_personal/dotfiles/dotfiles/bin/agent-state hook question",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "command": "bash /mnt/c/Code/_personal/dotfiles/dotfiles/bin/agent-state hook plan",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      },
      {
        "hooks": [
          {
            "command": "python3 /mnt/c/Code/_docs/docs-claude-helpers/hooks/no-comment-guard.py --allow-single-line --no-azdo-refs",
            "statusMessage": "Checking for Claude-authored comments",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      },
      {
        "hooks": [
          {
            "command": "bash /mnt/c/Code/_personal/dotfiles/dotfiles/agents/hooks/askuserquestion-preview-guard.sh",
            "statusMessage": "Blocking preview-style questions",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "command": "bash /mnt/c/Code/_personal/dotfiles/dotfiles/agents/hooks/command-guard.sh",
            "statusMessage": "Enforce bash rules",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "{ echo \"[$(date)] Claude Code Session Startup\"; cd /mnt/c/Code/_docs/docs-claude-helpers && git.exe pull --rebase --ff-only && /mnt/c/Code/_personal/dotfiles/dotfiles/agents/sync-agents.sh ; } > /tmp/claude-session-start.log 2>&1 || true",
            "statusMessage": "Syncing docs-claude-helpers and rebuilding agents",
            "timeout": 120,
            "type": "command"
          },
          {
            "command": "bash /mnt/c/Code/_personal/dotfiles/dotfiles/bin/agent-state hook idle",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "bash /mnt/c/Code/_personal/dotfiles/dotfiles/bin/agent-state end",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash /mnt/c/Code/_personal/dotfiles/dotfiles/bin/agent-state hook done",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash /mnt/c/Code/_personal/dotfiles/dotfiles/bin/agent-state hook working",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus[1m]",
  "permissions": {
    "allow": [
      "Bash(cli-anything-azdo:*)",
      "Bash(cli-anything-icepanel:*)",
      "Bash(azdo-cli:*)",
      "Bash(icepanel-cli:*)",
      "Bash(cat:*)",
      "Bash(fdfind:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(npm install:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npm start:*)",
      "Bash(npx vitest run)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(git.exe checkout:*)",
      "Bash(git.exe commit:*)",
      "Bash(git.exe status:*)",
      "Bash(git.exe add:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(repos:*)",
      "Bash(echo:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git.exe push:*)",
      "Bash(bash -c:*)",
      "Bash(sh -c:*)",
      "Bash(eval:*)",
      "Bash(exec:*)",
      "Bash(env:*)"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "work-item-authoring": "user-invocable-only"
  },
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "command": "/home/dave/.claude/statusline-detailed.sh",
    "type": "command"
  },
  "tui": "fullscreen",
  "workflowKeywordTriggerEnabled": false
}
