#!/bin/bash

set -uo pipefail

CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
PROJECTS_DIR="$CLAUDE_DIR/projects"
SESSIONS_DIR="$CLAUDE_DIR/sessions"
BLOCKLIST="${XDG_DATA_HOME:-$HOME/.local/share}/claude-sessions/blocklist"
SELF="$(command -v claude-sessions 2>/dev/null || realpath "$0")"

AGENT_STATE="${SELF%/*}/agent-state"
[[ -x "$AGENT_STATE" ]] || AGENT_STATE="$(command -v agent-state 2>/dev/null)"
TMUX_SESSIONS="${SELF%/*}/tmux-sessions"
[[ -x "$TMUX_SESSIONS" ]] || TMUX_SESSIONS="$(command -v tmux-sessions 2>/dev/null)"

die() { echo "claude-sessions: $*" >&2; exit 1; }

need() {
    for c in "$@"; do
        command -v "$c" >/dev/null 2>&1 || die "required tool not found: $c"
    done
}

# One jq per marker, so a half-written file cannot hide the markers after it.
live_sessions() {  # id, pid and tmux target of each session whose process is still running
    local f id pid target
    for f in "$SESSIONS_DIR"/*.json; do
        IFS=$'\t' read -r id pid target < <(jq -r \
            'select(.sessionId and .pid) | [.sessionId, .pid, (.tmux // "")] | @tsv' "$f" 2>/dev/null)
        [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null || continue
        printf '%s\t%s\t%s\n' "$id" "$pid" "$target"
    done
}

live_ids() {
    live_sessions | cut -f1 | sort -u
}

is_live() {  # is_live <id> <newline-delimited-live-set>
    [[ $'\n'$2$'\n' == *$'\n'$1$'\n'* ]]
}

agent_pane() {  # agent_pane <agent pid>  -- its pane, when one is recorded and still alive
    local state pane
    [[ -n "${1:-}" && -n "$AGENT_STATE" ]] || return 0
    command -v tmux >/dev/null 2>&1 || return 0
    IFS=$'\t' read -r state pane < <("$AGENT_STATE" pane "$1")
    [[ -n "${pane:-}" ]] && pane_is_alive "$pane" && printf '%s' "$pane"
    return 0
}

has_turns() {  # has_turns <transcript-path>  -- an agent reply, or a prompt of your own
    rg -q '"type":"assistant"' "$1" 2>/dev/null && return 0
    jq -r 'select(.type=="user" and ((.isMeta // false) == false))
           | (if (.message.content | type) == "string" then .message.content
              else ([.message.content[]? | select(.type=="text") | .text] | first // "") end)
           | select((startswith("<command-name>") or startswith("<local-command-stdout>")) | not)
           | @json' "$1" 2>/dev/null | rg -q .
}

end_session() {  # end_session <id>  -- remove live marker(s) whose sessionId matches
    need jq
    local id="$1" f
    [[ -n "$id" ]] || return 0
    for f in "$SESSIONS_DIR"/*.json; do
        [[ -f "$f" ]] || continue
        [[ "$(jq -r '.sessionId // empty' "$f" 2>/dev/null)" == "$id" ]] && rm -f "$f"
    done
}

block_session() {  # block_session <id>  -- record id in blocklist, transcript kept
    local id="$1" existing
    [[ -n "$id" ]] || return 0
    mkdir -p "$(dirname "$BLOCKLIST")" 2>/dev/null
    if [[ -f "$BLOCKLIST" ]]; then
        while IFS= read -r existing; do
            [[ "$existing" == "$id" ]] && return 0
        done < "$BLOCKLIST"
    fi
    printf '%s\n' "$id" >> "$BLOCKLIST"
}

first_user_fields() {  # cwd and gitBranch (tab-separated) from the first user line
    jq -r '[.cwd // "?", .gitBranch // "?"] | @tsv'
}

opening_prompt() {  # opening_prompt <transcript-path>  -- first real ask, slash commands as typed
    jq -nrR '
        def text: if (.message.content | type) == "string" then .message.content
                  else ([.message.content[]? | select(.type=="text") | .text] | first // "") end;
        def as_typed:
            (capture("<command-name>(?<n>[^<]*)</command-name>").n) as $name
            | ((capture("<command-args>(?<a>[\\s\\S]*?)</command-args>").a) // "") as $args
            | "\($name) \($args)" | rtrimstr(" ");
        [limit(50; inputs | fromjson? | select(.type == "user"))] as $u
        | first(range(0; $u | length) as $i
            | $u[$i] | select((.isMeta // false) | not) | text
            | select(. != "" and (startswith("<local-command") | not))
            | if test("<command-name>") then
                select(($u[$i + 1] // {} | text | startswith("<local-command-stdout>")) | not)
                | as_typed | select(test("^/clear( |$)") | not)
              else . end) // ""' "$1" 2>/dev/null
}

search_text() {  # search_text <transcript-path> <opening prompt>  -- one line of what it was about
    local last summaries text
    last="$(rg '"type":"last-prompt"' "$1" 2>/dev/null | tail -1 | jq -r '.lastPrompt // empty')"
    summaries="$(rg '"type":"summary"' "$1" 2>/dev/null | jq -r '.summary // empty')"
    text="$(printf '%s %s %s' "$2" "$summaries" "$last" | tr -d '\033' | tr -s '[:space:]' ' ')"
    printf '%s' "${text:0:400}"
}

compute_fields() {
    local path="$1" first cwd branch prompt title proj turns
    first="$(rg -m1 '"type":"user"' "$path" 2>/dev/null)"
    [[ -n "$first" ]] || return 1
    IFS=$'\t' read -r cwd branch < <(printf '%s' "$first" | first_user_fields)
    prompt="$(opening_prompt "$path")"
    title="$(rg '"type":"ai-title"' "$path" 2>/dev/null | tail -1 | jq -r '.aiTitle // empty')"
    [[ -n "$title" ]] || title="$(awk 'NF { print; exit }' <<<"$prompt")"
    [[ -n "$title" ]] || title="(untitled)"
    title="${title//$'\t'/ }"
    proj="${cwd##*/}"
    if has_turns "$path"; then turns=1; else turns=0; fi
    printf '%s\t%s\t%s\t%s\t%s\t%s' "$cwd" "$branch" "$proj" "$title" "$turns" \
        "$(search_text "$path" "$prompt")"
}

# A per-transcript cache keyed on file mtime keeps repeat runs fast: only new or
# changed sessions are recomputed. The live marker is applied at print time, not
# cached, so it always reflects the current process list.
build_list() {
    need jq rg
    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/claude-sessions"
    local cache="$cache_dir/cache-v3.tsv"
    rm -f "$cache_dir/cache.tsv" "$cache_dir/cache-v2.tsv"
    mkdir -p "$cache_dir" 2>/dev/null

    local markers; markers="$(live_sessions)"
    local live; live="$(cut -f1 <<<"$markers" | sort -u)"
    declare -A CM CR BL LIVE_PID
    local lid lpid
    while IFS=$'\t' read -r lid lpid _; do
        [[ -n "$lid" ]] && LIVE_PID["$lid"]="$lpid"
    done <<<"$markers"
    if [[ -f "$cache" ]]; then
        local cm cid ccwd cbranch cproj ctitle cturns ctext
        while IFS=$'\t' read -r cm cid ccwd cbranch cproj ctitle cturns ctext; do
            [[ -n "$cid" && -n "$cturns" ]] || continue
            CM["$cid"]="$cm"
            CR["$cid"]="$ccwd"$'\t'"$cbranch"$'\t'"$cproj"$'\t'"$ctitle"$'\t'"$cturns"$'\t'"$ctext"
        done < "$cache"
    fi
    if [[ -f "$BLOCKLIST" ]]; then
        local bid
        while IFS= read -r bid; do
            [[ -n "$bid" ]] && BL["$bid"]=1
        done < "$BLOCKLIST"
    fi

    local tmp; tmp="$(mktemp)"
    local mtime path id fields cwd branch proj title turns text date live_mark pane display
    stat -c '%Y %n' "$PROJECTS_DIR"/*/*.jsonl 2>/dev/null | sort -rn | \
    while read -r mtime path; do
        [[ -s "$path" ]] || continue
        id="${path##*/}"; id="${id%.jsonl}"
        if [[ "${CM[$id]:-}" == "$mtime" ]]; then
            fields="${CR[$id]}"
        else
            fields="$(compute_fields "$path")" || continue
        fi
        [[ -n "$fields" ]] || continue
        printf '%s\t%s\t%s\n' "$mtime" "$id" "$fields" >> "$tmp"
        [[ -n "${BL[$id]:-}" ]] && continue
        IFS=$'\t' read -r cwd branch proj title turns text <<<"$fields"
        [[ "$turns" == 1 ]] || is_live "$id" "$live" || continue
        printf -v date '%(%Y-%m-%d %H:%M)T' "$mtime"
        pane=""
        if is_live "$id" "$live"; then
            live_mark="●"
            pane="$(agent_pane "${LIVE_PID[$id]:-}")"
        else
            live_mark=" "
        fi
        printf -v display '%-16s %1s  %-60.60s  %-20.20s  %s  \e[2m%s\e[0m' \
            "$date" "$live_mark" "$title" "$proj" "$branch" "$text"
        printf '%s\t%s\t%s\t%s\n' "$display" "$id" "$cwd" "$pane"
    done
    mv -f "$tmp" "$cache" 2>/dev/null || rm -f "$tmp"
}

ASK_INSTRUCTIONS="You find the user's past Claude Code sessions. You are given a question and a list \
of sessions, one per line: the session id, a tab, then when it was last active, its title, project, \
branch and what it was about. Reply with the ids of the sessions that answer the question, most \
relevant first, one per line, at most 15. Reply with ids only. If none fit, reply with nothing."

no_answer() {  # no_answer <message>  -- a row that explains, and cannot be resumed
    printf '  %s\t\t\t\n' "$1"
}

ask_claude() {  # ask_claude <question> <candidates>  -- the model's reply
    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/claude-sessions"
    mkdir -p "$cache_dir" 2>/dev/null
    printf 'Today is %s.\n\nQuestion: %s\n\nSessions:\n%s\n' "$(date +%F)" "$1" "$2" \
        | ( cd "$cache_dir" && timeout 120 claude -p --model "${CLAUDE_SESSIONS_ASK_MODEL:-haiku}" \
            --no-session-persistence --tools "" --strict-mcp-config --setting-sources project \
            --system-prompt "$ASK_INSTRUCTIONS" )
}

ask_sessions() {  # ask_sessions <question>  -- --list rows, most relevant first
    need claude
    local question="$1" rows line id candidates reply found=0
    declare -A ROW SHOWN
    rows="$(build_list)"
    while IFS= read -r line; do
        id="$(cut -f2 <<<"$line")"
        [[ -n "$id" ]] || continue
        ROW["$id"]="$line"
        candidates+="$id"$'\t'"$(cut -f1 <<<"$line" | sed 's/\x1b\[[0-9;]*m//g' | tr -s ' ')"$'\n'
    done <<<"$rows"
    if ! reply="$(ask_claude "$question" "$candidates")"; then
        no_answer "ask failed: claude did not answer"
        return 0
    fi
    while IFS= read -r id; do
        [[ -n "${ROW[$id]:-}" && -z "${SHOWN[$id]:-}" ]] || continue
        SHOWN["$id"]=1
        printf '%s\n' "${ROW[$id]}"
        found=1
    done < <(rg -o '[0-9A-Za-z-]{8,}' <<<"$reply")
    (( found )) || no_answer "no matching sessions for: $question"
}

FILTER_PROMPT='session> '
ASK_PROMPT='ask> '
ASK_HEADER='ask: describe the session, enter to search   •   ctrl-s or ?: back to filtering'

filter_header() {
    local default other
    default="${CLAUDE_SESSIONS_DEFAULT:-resume}"
    [[ "$default" == "fork" ]] && other="resume" || other="fork"
    [[ "$default" == "resume" ]] && default="attach or resume"
    printf 'enter: %s   •   alt-enter: %s   •   alt-e: end   •   alt-d: delete   •   ctrl-s or ?: ask   •   ● = live' \
        "$default" "$other"
}

switch_mode() {  # switch_mode <asking 0|1> [query to keep]  -- fzf actions to flip filter/ask mode
    if (( $1 )); then
        printf 'enable-search+change-prompt(%s)+change-ghost()+change-header(%s)' \
            "$FILTER_PROMPT" "$(filter_header)"
    else
        printf 'disable-search+change-prompt(%s)+change-ghost(describe the session, then enter)+change-header(%s)' \
            "$ASK_PROMPT" "$ASK_HEADER"
    fi
    printf '+reload(%s --list)' "$SELF"
    (( $# > 1 )) || return 0
    if [[ -n "$2" ]]; then printf '+change-query:%s' "$2"; else printf '+clear-query'; fi
}

fzf_event() {  # fzf_event <toggle|change|enter|alt-enter>  -- actions for the mode in $FZF_PROMPT
    local query="${FZF_QUERY:-}" asking=0
    [[ "${FZF_PROMPT:-}" == "$ASK_PROMPT" ]] && asking=1
    case "$1" in
        toggle) switch_mode "$asking" ;;
        change) [[ "$query" == \?* ]] && switch_mode "$asking" "${query#\?}" ;;
        enter|alt-enter)
            if (( ! asking )); then
                printf 'print(%s)+accept' "$1"
            elif [[ -n "$query" ]]; then
                printf 'reload(%s --ask {q})+enable-search+change-prompt(%s)+change-ghost()+clear-query+change-header:%s' \
                    "$SELF" "$FILTER_PROMPT" "ranked for: $query   •   ctrl-s twice: all sessions"
            fi ;;
    esac
    return 0
}

render_pager() {  # reads markdown on stdin, renders it for the preview pane
    local width="${FZF_PREVIEW_COLUMNS:-100}"
    if command -v batcat >/dev/null 2>&1; then
        batcat --language md --color always --style plain --paging never \
            --wrap character --terminal-width "$width"
    elif command -v bat >/dev/null 2>&1; then
        bat --language md --color always --style plain --paging never \
            --wrap character --terminal-width "$width"
    else
        cat
    fi
}

render_preview() {  # render_preview <id> <cwd> [live pane]
    if [[ -n "${3:-}" && -n "$AGENT_STATE" ]] && pane_is_alive "$3"; then
        exec "$AGENT_STATE" preview "$3"
    fi

    need jq rg
    local id="$1" cwd="${2:-}"
    [[ -n "$id" ]] || return 0

    local matches=( "$PROJECTS_DIR"/*/"$id.jsonl" )
    local path="${matches[0]}"
    [[ -f "$path" ]] || { echo "No transcript found for $id"; return 0; }

    local first start prompt branch title lastp msgs mtime lastact live mark
    first="$(rg -m1 '"type":"user"' "$path" 2>/dev/null)"
    start="$(printf '%s' "$first" | jq -r '.timestamp // ""')"
    branch="$(printf '%s' "$first" | jq -r '.gitBranch // "?"')"
    prompt="$(opening_prompt "$path")"
    title="$(rg '"type":"ai-title"' "$path" 2>/dev/null | tail -1 | jq -r '.aiTitle // empty')"
    lastp="$(rg '"type":"last-prompt"' "$path" 2>/dev/null | tail -1 | jq -r '.lastPrompt // empty')"
    msgs="$(rg -c '"type":"user"|"type":"assistant"' "$path" 2>/dev/null || echo 0)"
    mtime="$(stat -c %Y "$path")"
    lastact="$(date -d "@$mtime" '+%Y-%m-%d %H:%M')"
    [[ -n "$start" ]] && start="$(date -d "$start" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "$start")"
    live="$(live_ids)"
    if is_live "$id" "$live"; then mark="  \`● live\`"; else mark=""; fi

    {
        printf '# %s\n\n' "${title:-（untitled）}"
        printf '**Project**  %s  \n' "$cwd"
        printf '**Branch**   %s   **Messages** %s%s  \n' "$branch" "$msgs" "$mark"
        printf '**Started**  %s   **Last active** %s\n\n' "${start:-?}" "$lastact"
        printf '## Opening prompt\n\n%s\n\n' "${prompt:-（none）}"
        printf '## Where it left off\n\n%s\n' "${lastp:-（none）}"
    } | render_pager
}

resolve_action() {  # resolve_action <key> -> echoes resume|fork
    local key="$1"
    local default="${CLAUDE_SESSIONS_DEFAULT:-resume}"
    [[ "$default" == "fork" || "$default" == "resume" ]] || default="resume"
    local other; [[ "$default" == "fork" ]] && other="resume" || other="fork"
    if [[ "$key" == "alt-enter" ]]; then echo "$other"; else echo "$default"; fi
}

free_session_name() {  # free_session_name <base>  -- base, base-2, base-3, ...
    local base="$1" name="$1" n=2
    while tmux has-session -t "=$name" 2>/dev/null; do
        name="$base-$n"
        ((n++))
    done
    printf '%s' "$name"
}

do_action() {  # do_action <key> <id> <cwd>
    local key="$1" id="$2" cwd="${3:-}"
    local action; action="$(resolve_action "$key")"
    if [[ "$action" == "resume" ]] && is_running "$id"; then
        attach_to_running "$id"
        return
    fi
    local cmd=( claude --resume "$id" )
    [[ "$action" == "fork" ]] && cmd+=( --fork-session )

    if [[ -z "${TMUX:-}" ]] && command -v tmux >/dev/null 2>&1; then
        cmd=( tmux new-session -s "$(free_session_name "cc-${cwd##*/}")" "${cmd[@]}" )
    fi

    if [[ -n "${CLAUDE_SESSIONS_DRYRUN:-}" ]]; then
        printf 'cd %q && %s\n' "$cwd" "${cmd[*]}"
        return 0
    fi
    [[ -d "$cwd" ]] || die "directory no longer exists: $cwd"
    cd "$cwd" || die "cannot cd to $cwd"
    exec "${cmd[@]}"
}

live_pane() {  # live_pane <id>  -- the pane its marker says it is running in, if any
    local target
    target="$(live_sessions | awk -F'\t' -v id="$1" '$1 == id && $3 != "" { print $3; exit }')"
    [[ -n "$target" ]] || return 1
    printf '%s' "${target##*.}"
}

pane_is_alive() {  # pane_is_alive <pane>
    [[ -n "$(tmux display-message -p -t "$1" '#{pane_id}' 2>/dev/null)" ]]
}

attach_to_pane() {  # attach_to_pane <pane>
    [[ -n "$AGENT_STATE" ]] || die "required tool not found: agent-state"
    if [[ -n "${CLAUDE_SESSIONS_DRYRUN:-}" ]]; then
        printf 'agent-state jump %s\n' "$1"
        return 0
    fi
    exec "$AGENT_STATE" jump "$1"
}

resume_in_own_session() {  # resume_in_own_session <id> <cwd> <action>
    local name cmd
    [[ -d "$2" ]] || die "directory no longer exists: $2"
    [[ -n "$TMUX_SESSIONS" ]] || die "required tool not found: tmux-sessions"
    name="$(free_session_name "cc-${2##*/}")"
    cmd=( claude --resume "$1" )
    [[ "$3" == "fork" ]] && cmd+=( --fork-session )

    if [[ -n "${CLAUDE_SESSIONS_DRYRUN:-}" ]]; then
        printf 'tmux new-session -d -s %s -c %s %s\n' "$name" "$2" "${cmd[*]}"
        printf 'tmux-sessions --attach %s\n' "$name"
        return 0
    fi
    tmux new-session -d -s "$name" -c "$2" "${cmd[@]}" \
        || die "could not start a tmux session in $2"
    exec "$TMUX_SESSIONS" --attach "$name"
}

# A second process on a running session's transcript would split it, so go to the one running.
attach_to_running() {  # attach_to_running <id>
    local pane
    pane="$(live_pane "$1")"
    [[ -n "$pane" ]] && pane_is_alive "$pane" \
        || die "session $1 is already running outside tmux; fork it instead of resuming it"
    attach_to_pane "$pane"
}

is_running() {  # is_running <id>
    is_live "$1" "$(live_ids)"
}

resumed_id() {  # resumed_id <claude args...>  -- the session they reopen in place, if any
    local arg prev=""
    for arg in "$@"; do
        [[ "$arg" == --fork-session ]] && return 1
    done
    for arg in "$@"; do
        [[ "$prev" == --resume || "$prev" == -r ]] && { printf '%s' "$arg"; return 0; }
        [[ "$arg" == --resume=* ]] && { printf '%s' "${arg#--resume=}"; return 0; }
        prev="$arg"
    done
    return 1
}

resumes_running() {  # resumes_running <claude args...>  -- the running session they would open a second time
    local id
    id="$(resumed_id "$@")" && is_running "$id" && printf '%s\n' "$id"
}

do_jump_action() {  # do_jump_action <key> <id> <cwd>
    need tmux
    local action
    action="$(resolve_action "$1")"
    if [[ "$action" == "resume" ]] && is_running "$2"; then
        attach_to_running "$2"
        return
    fi
    resume_in_own_session "$2" "$3" "$action"
}

interactive() {  # interactive [jump]
    need fzf jq rg
    local mode="${1:-}" out key line id cwd

    out="$(build_list | fzf \
        --ansi --delimiter '\t' --with-nth 1 \
        --layout=reverse --no-hscroll --exact \
        --prompt "$FILTER_PROMPT" \
        --header "$(filter_header)" \
        --bind "enter:transform:$SELF --fzf-event enter" \
        --bind "alt-enter:transform:$SELF --fzf-event alt-enter" \
        --bind "ctrl-s:transform:$SELF --fzf-event toggle" \
        --bind "change:transform:$SELF --fzf-event change" \
        --bind "alt-e:execute-silent($SELF --end {2})+reload($SELF --list)" \
        --bind "alt-d:execute-silent($SELF --block {2})+reload($SELF --list)" \
        --bind 'focus:transform:[[ -n {4} ]] && echo change-preview-window:nowrap || echo change-preview-window:wrap' \
        --preview "$SELF --preview {2} {3} {4}" \
        --preview-window 'right,55%,wrap' )"
    [[ -n "$out" ]] || exit 0
    key="$(head -1 <<<"$out")"
    line="$(sed -n '2p' <<<"$out")"
    [[ -n "$line" ]] || exit 0
    id="$(cut -f2 <<<"$line")"
    [[ -n "$id" ]] || exit 0
    cwd="$(cut -f3 <<<"$line")"
    if [[ "$mode" == "jump" ]]; then
        do_jump_action "$key" "$id" "$cwd"
    else
        do_action "$key" "$id" "$cwd"
    fi
}

usage() {
    cat <<'EOF'
claude-sessions: fuzzy-find and resume a past Claude Code session from any project

Lists recent sessions across every project folder, previews each, and on
selection jumps to the session's original directory and resumes (or forks) it.

Usage:
  claude-sessions                 # interactive picker (fzf)
  claude-sessions --jump          # picker that leaves you in the session's own tmux session
  claude-sessions --list          # print the session list (non-interactive)
  claude-sessions --preview <id> <cwd>   # render one session's preview
  claude-sessions --help

Keys (interactive):
  enter        run the default action
  alt-enter    run the other action
  alt-e        end a live session (remove its live marker)
  alt-d        delete a session from the picker (adds it to the blocklist)
  ctrl-s or ?  switch between filtering and asking (a ? typed at the start toggles)
  ● in a row   the session is currently live (open in another process)

Filtering matches the title, project, branch, opening prompt, compaction summaries
and last prompt. Terms match exactly as substrings: 'word' matches a whole word,
and a single leading ' makes that term fuzzy. Asking sends your question and that same text for every session to
Claude (Haiku by default), then lists the sessions it ranks as relevant; enter on a
result resumes it as usual.

A session that is still running is never resumed a second time: one in a tmux pane
is attached to where it already is, and one running outside tmux is refused (fork
it instead). A marker whose process has exited does not count as running.

--jump is what the tmux binding on prefix Ctrl+a runs. It resumes any other session
in a tmux session of its own, named after its folder, which you then land in.
Either way you leave the session you were in, so the picker behaves like the agent
picker on prefix a.

Environment:
  CLAUDE_SESSIONS_DEFAULT   resume (default) | fork  -- which action enter runs
  CLAUDE_SESSIONS_DRYRUN    if set, print the commands instead of running them
  CLAUDE_SESSIONS_ASK_MODEL model used to answer questions (default haiku)
  CLAUDE_CONFIG_DIR         override the Claude config dir (default ~/.claude)

Files:
  blocklist    ${XDG_DATA_HOME:-~/.local/share}/claude-sessions/blocklist
               one session id per line; edit or delete it to un-hide sessions.

Suggested alias:  alias cs=claude-sessions
EOF
}

case "${1:-}" in
    --jump)        interactive jump ;;
    --list)        build_list ;;
    --preview)     render_preview "${2:-}" "${3:-}" "${4:-}" ;;
    --action)      do_action "${2:-}" "${3:-}" "${4:-}" ;;  # internal: test/hook entry
    --jump-action) do_jump_action "${2:-}" "${3:-}" "${4:-}" ;;  # internal: test entry
    --end)         end_session "${2:-}" ;;                   # internal: fzf bind
    --block)       block_session "${2:-}" ;;                 # internal: fzf bind
    --has-turns)   need jq rg; has_turns "${2:-}" ;;         # internal: test entry
    --opening-prompt) need jq; opening_prompt "${2:-}" ;;    # internal: test entry
    --ask)         ask_sessions "${2:-}" ;;                  # internal: fzf bind
    --fzf-event)   fzf_event "${2:-}" ;;                     # internal: fzf bind
    --resumes-running) need jq; shift; resumes_running "$@" ;;  # internal: cc guard
    --attach-running)  need jq tmux; attach_to_running "${2:-}" ;;  # internal: cc guard
    --help|-h)     usage ;;
    "")            interactive ;;
    *)             die "unknown option: $1 (try --help)" ;;
esac
