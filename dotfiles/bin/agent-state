#!/bin/bash

set -uo pipefail

SELF="$(command -v agent-state 2>/dev/null || realpath "$0")"
SESSIONS="${SELF%/*}/tmux-sessions"
[[ -x "$SESSIONS" ]] || SESSIONS="$(command -v tmux-sessions 2>/dev/null)"

PANE_OPT="@agent"
WINDOW_OPT="@agent_win"
AGENT_COMMANDS="${AGENT_STATE_COMMANDS:-claude:pi:codex:aider:opencode}"
STATE_DIR="${AGENT_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/agent-state}"
DETACHED_SESSION="not in tmux"

GROUP_TAG="g:"
TRANSCRIPT_TAIL=262144
PANE_FORMAT=$'#{pane_id}\t#{session_name}\t#{window_index}\t#{pane_index}\t'"$GROUP_TAG"$'#{session_group}\t#{pane_title}'
UNTITLED="Claude Code"
ALERT_MS=4000
TITLE_WIDTH=28
MIN_TITLE_WIDTH=8
ENTRY_OVERHEAD=5
DEFAULT_BUDGET=200
BUDGET_RESERVE=46

usage() {
    cat <<'EOF'
agent-state: track and surface AI agent states across every tmux session

Agent hooks stamp a state onto their own tmux pane. Pane options live in the
tmux server, so every state is readable from any session, attached or not.

Usage:
  agent-state set <state> [pane]   record a state
  agent-state hook <state> [pane]  hook entry: records the state, and the directory
                                   the agent reports it is working in
  agent-state clear [pane]         drop a pane's state
  agent-state ack [pane]           return it to idle, only if the agent had finished
  agent-state status [session]     server-wide roll-up for the status line, with
                                   agents in the named session coloured as "here"
  agent-state list                 one row per agent pane, for fzf
  agent-state preview <pane>       render one pane's recent output
  agent-state jump <pane>          select a pane, then hand its session to
                                   tmux-sessions --attach to arrive on
  agent-state pick                 fzf picker over every agent pane
  agent-state --help

States, most urgent first:
  permission 🔐  the agent wants permission to run something
  question   ❓  the agent has asked you a question
  plan       📝  the agent has a plan waiting for review
  waiting    ✋  the agent is blocked on you for some other reason
  done       ✅  the agent finished its turn, so it is your move
  working    ⏳  the agent is busy
  idle       💤  the agent is up with nothing to report, either because it has
                 only just booted or because you acknowledged the turn it finished

Reaching a state that wants your attention flashes a message on every attached
terminal except one already sitting on that agent, and the message expires on its
own, so there is never an alert to clear.

Every command is safe to run outside tmux and safe to run against a pane that
has already closed, so a hook can call it without ever failing the agent.

Environment:
  AGENT_STATE_COMMANDS   colon-separated process names treated as agents
                         (default: claude:pi:codex:aider:opencode)

Status colours are tmux options, so they can be changed live without editing
any file. The bar picks the change up on its next refresh:

  tmux set -g @agent_colour_here      white   # this session, matching the bar's own text
  tmux set -g @agent_colour_elsewhere black   # any other session

Any tmux style works. Keep the background out of it so the bar stays even.

Wiring: see docs/tmux.md
EOF
}

die() { echo "agent-state: $*" >&2; exit 2; }

have_tmux() { command -v tmux >/dev/null 2>&1; }

describes_why_blocked() {
    case "${1:-}" in question|plan) return 0 ;; *) return 1 ;; esac
}

blocks_without_saying_why() {
    case "${1:-}" in permission|waiting) return 0 ;; *) return 1 ;; esac
}

wants_attention() {
    describes_why_blocked "$1" || blocks_without_saying_why "$1" || [[ "${1:-}" == "done" ]]
}

rank() {
    case "${1:-}" in
        permission) echo 6 ;;
        question)   echo 5 ;;
        plan)       echo 4 ;;
        waiting)    echo 3 ;;
        done)       echo 2 ;;
        working)    echo 1 ;;
        *)          echo 0 ;;
    esac
}

glyph() {
    case "${1:-}" in
        permission) printf '🔐' ;;
        question)   printf '❓' ;;
        plan)       printf '📝' ;;
        waiting)    printf '✋' ;;
        working)    printf '⏳' ;;
        done)       printf '✅' ;;
        *)          printf '💤' ;;
    esac
}

HERE_OPT="@agent_colour_here"
ELSEWHERE_OPT="@agent_colour_elsewhere"
HERE_DEFAULT="white"
ELSEWHERE_DEFAULT="black"

configured_colour() {  # configured_colour <tmux option> <default>
    local value
    value="$(tmux show-option -gqv "$1" 2>/dev/null)"
    [[ -n "$value" ]] && printf '%s' "$value" || printf '%s' "$2"
}

window_of() {  # window_of <pane>
    tmux display-message -p -t "$1" '#{session_name}:#{window_index}' 2>/dev/null
}

highest_ranked_state_in_window() {  # highest_ranked_state_in_window <window>
    local state best="" best_rank=0 state_rank
    while IFS= read -r state; do
        state_rank="$(rank "$state")"
        if (( state_rank > best_rank )); then
            best_rank="$state_rank"
            best="$state"
        fi
    done < <(tmux list-panes -t "$1" -F "#{${PANE_OPT}}" 2>/dev/null)
    printf '%s' "$best"
}

mirror_state_onto_window() {  # mirror_state_onto_window <pane>
    local window best
    window="$(window_of "$1")"
    [[ -n "$window" ]] || return 0

    best="$(highest_ranked_state_in_window "$window")"
    if [[ -n "$best" ]]; then
        tmux set-option -w -t "$window" "$WINDOW_OPT" "$best" 2>/dev/null
    else
        tmux set-option -w -t "$window" -u "$WINDOW_OPT" 2>/dev/null
    fi
    return 0
}

supersedes() {  # supersedes <new state> <current state>
    blocks_without_saying_why "$1" && describes_why_blocked "$2" && return 1
    return 0
}

announce_to_other_clients() {  # announce_to_other_clients <pane> <state> <dir>
    local tty focused project title message
    have_tmux || return 0

    project="${3%/}"
    project="${project##*/}"
    message="$(glyph "$2") ${project:-/}"

    if [[ -n "$1" ]]; then
        title="$(readable_title "$(tmux display-message -p -t "$1" '#{pane_title}' 2>/dev/null)")"
        [[ -n "$title" ]] && message+=": $title"
    fi

    while IFS=$'\t' read -r tty focused; do
        [[ -n "$tty" && "$focused" != "$1" ]] || continue
        tmux display-message -c "$tty" -d "$ALERT_MS" "$message" 2>/dev/null
    done < <(tmux list-clients -F "#{client_tty}"$'\t'"#{pane_id}" 2>/dev/null)
    return 0
}

record_agent_state() {  # record_agent_state <agent pid> <state> <pane> <dir>
    local id="$1" current=""
    [[ -n "$id" ]] || return 0
    mkdir -p "$STATE_DIR" 2>/dev/null || return 0
    [[ -r "$STATE_DIR/$id" ]] && read -r current < "$STATE_DIR/$id"
    if blocks_without_saying_why "$2"; then
        supersedes "$2" "$current" || return 0
    fi
    printf '%s\n%s\n%s\n' "$2" "$3" "$4" > "$STATE_DIR/$id" 2>/dev/null
    [[ "$2" != "$current" ]] && wants_attention "$2" \
        && announce_to_other_clients "$3" "$2" "$4"
    return 0
}

forget_agent_state() {  # forget_agent_state <agent pid>
    [[ -n "${1:-}" ]] || return 0
    rm -f "$STATE_DIR/$1" "$STATE_DIR/$1.title" 2>/dev/null
    return 0
}

set_state() {  # set_state <state> [pane]
    local state="${1:-}" pane="${2:-${TMUX_PANE:-}}"
    case "$state" in
        working|waiting|done|permission|question|plan|idle) ;;
        *) die "unknown state: ${state:-(none)}" ;;
    esac
    [[ -n "$pane" ]] || return 0
    have_tmux || return 0

    if blocks_without_saying_why "$state"; then
        supersedes "$state" \
            "$(tmux display-message -p -t "$pane" "#{${PANE_OPT}}" 2>/dev/null)" || return 0
    fi

    tmux set-option -p -t "$pane" "$PANE_OPT" "$state" 2>/dev/null || return 0
    mirror_state_onto_window "$pane"
    return 0
}

PARENT_PID=""

set_parent_of() {  # set_parent_of <pid>
    local stat rest
    read -r stat < "/proc/$1/stat" 2>/dev/null || return 1
    rest="${stat#*) }"
    rest="${rest#* }"
    PARENT_PID="${rest%% *}"
    [[ -n "$PARENT_PID" ]]
}

agent_pid() {
    local pid="$PPID" depth=0 comm
    [[ -n "${AGENT_STATE_PID:-}" ]] && { printf '%s' "$AGENT_STATE_PID"; return 0; }
    while [[ -n "$pid" && "$pid" != "0" && $depth -lt 8 ]]; do
        read -r comm < "/proc/$pid/comm" 2>/dev/null || return 1
        [[ ":$AGENT_COMMANDS:" == *":$comm:"* ]] && { printf '%s' "$pid"; return 0; }
        set_parent_of "$pid" || return 1
        pid="$PARENT_PID"
        depth=$(( depth + 1 ))
    done
    return 1
}

transcript_from_payload() {
    local payload=""
    [[ -t 0 ]] && return 0
    IFS= read -r -d '' -t 2 payload
    [[ -n "$payload" ]] || return 0
    command -v jq >/dev/null 2>&1 || return 0
    printf '%s' "$payload" | jq -r '.transcript_path // empty' 2>/dev/null
}

record_title_from_transcript() {  # record_title_from_transcript <agent pid>
    local pid="${1:-}" transcript title
    [[ -n "$pid" ]] || return 0
    transcript="$(transcript_from_payload)"
    [[ -n "$transcript" && -r "$transcript" ]] || return 0

    title="$(tail -c "$TRANSCRIPT_TAIL" "$transcript" 2>/dev/null \
        | rg '"type":"ai-title"' 2>/dev/null | tail -1 \
        | jq -r '.aiTitle // empty' 2>/dev/null)"
    [[ -n "$title" ]] || return 0

    mkdir -p "$STATE_DIR" 2>/dev/null || return 0
    printf '%s\n' "$(readable_title "$title")" > "$STATE_DIR/$pid.title" 2>/dev/null
    return 0
}

hook() {  # hook <state> [pane]
    local state="${1:-}" pane="${2:-${TMUX_PANE:-}}" pid
    pid="$(agent_pid)"
    record_agent_state "$pid" "$state" "$pane" "$PWD"

    if [[ "$state" == "done" && -z "$pane" ]]; then
        record_title_from_transcript "$pid"
        return 0
    fi

    [[ -n "$pane" ]] || return 0
    have_tmux || return 0
    set_state "$state" "$pane"
}

end_hook() {
    forget_agent_state "$(agent_pid)"
    clear_state "${1:-}"
}

clear_state() {  # clear_state [pane]
    local pane="${1:-${TMUX_PANE:-}}"
    [[ -n "$pane" ]] || return 0
    have_tmux || return 0

    tmux set-option -p -t "$pane" -u "$PANE_OPT" 2>/dev/null || return 0
    mirror_state_onto_window "$pane"
    return 0
}

declare -A PANE_SESSION PANE_LABEL PANE_TITLE

readable_title() {  # readable_title <raw pane title>
    local title="${1:-}"
    title="${title#"${title%%[[:alnum:]]*}"}"
    [[ "$title" == "$UNTITLED" ]] && return 0
    printf '%s' "${title//\#/\#\#}"
}

preferred_session_row() {  # preferred_session_row <pane> <session> <group>
    [[ -z "${PANE_SESSION[$1]:-}" ]] && return 0
    [[ -z "$3" || "$2" == "$3" ]]
}

load_panes() {
    local pane session window index group title
    PANE_SESSION=(); PANE_LABEL=(); PANE_TITLE=()
    have_tmux || return 0
    while IFS=$'\t' read -r pane session window index group title; do
        [[ -n "$pane" ]] || continue
        group="${group#"$GROUP_TAG"}"
        preferred_session_row "$pane" "$session" "$group" || continue
        PANE_SESSION[$pane]="$session"
        PANE_LABEL[$pane]="w$window-p$index"
        PANE_TITLE[$pane]="$(readable_title "$title")"
    done < <(tmux list-panes -a -F "$PANE_FORMAT" 2>/dev/null)
    return 0
}

rows() {
    local file pid state pane dir project title
    load_panes
    for file in "$STATE_DIR"/*; do
        [[ -f "$file" ]] || continue
        pid="${file##*/}"
        [[ "$pid" =~ ^[0-9]+$ ]] || continue
        kill -0 "$pid" 2>/dev/null || { rm -f "$file" "$file.title" 2>/dev/null; continue; }

        state=""; pane=""; dir=""
        { read -r state; read -r pane; read -r dir; } < "$file"

        project="${dir%/}"
        project="${project##*/}"
        [[ -n "$project" ]] || project="/"

        if [[ -n "$pane" && -n "${PANE_SESSION[$pane]:-}" ]]; then
            printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                "${state:-idle}" "${PANE_SESSION[$pane]}" \
                "$project-${PANE_LABEL[$pane]}" "$pane" "$project" "$dir" \
                "${PANE_TITLE[$pane]:-}"
        else
            title=""
            [[ -r "$file.title" ]] && read -r title < "$file.title"
            printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                "${state:-idle}" "$DETACHED_SESSION" "$project" "!$pid" "$project" "$dir" \
                "$title"
        fi
    done
    return 0
}

stable_rows() {
    local line session pane group
    while IFS= read -r line; do
        IFS=$'\t' read -r _ session _ pane _ <<<"$line"
        [[ "$pane" == !* ]] && group=1 || group=0
        printf '%s\t%s\t%s\t%s\n' "$group" "$session" "${pane#%}" "$line"
    done < <(rows) | sort -t$'\t' -k1,1n -k2,2 -k3,3n | cut -f4-
}

sorted_rows() {
    local line state
    while IFS= read -r line; do
        state="${line%%$'\t'*}"
        printf '%s\t%s\n' "$(rank "$state")" "$line"
    done < <(stable_rows) | sort -rn -k1,1 -s | cut -f2-
}

describe_agent() {  # describe_agent <project> <title> <layout> <title room>
    local room="$4"
    [[ -n "$2" && "$3" != "folder" ]] || { printf '%s' "$1"; return 0; }
    (( room > TITLE_WIDTH )) && room=$TITLE_WIDTH
    if [[ "$3" == "both" ]]; then
        printf '%s: %s' "$1" "${2:0:$room}"
    else
        printf '%s' "${2:0:$room}"
    fi
}

# The folder is the less informative half, so it is dropped before the title is.
choose_layout() {  # choose_layout <budget> <count> <longest project> <with folder>
    local share=$(( $1 / $2 - ENTRY_OVERHEAD ))
    if [[ "$4" == "yes" ]] && (( share - $3 - 2 >= MIN_TITLE_WIDTH )); then
        printf 'both %s' "$(( share - $3 - 2 ))"
    elif (( share >= MIN_TITLE_WIDTH )); then
        printf 'title %s' "$share"
    else
        printf 'folder 0'
    fi
}

status() {  # status [session asking] [--with-folder] [--width <cols>]
    local asking="" with_folder="no" budget="" here elsewhere style arg layout room longest=0
    local state session label pane project dir title out="" sep="" i
    local -a states sessions projects titles

    while (( $# )); do
        case "$1" in
            --with-folder) with_folder="yes" ;;
            --width) shift; budget=$(( ${1:-0} - BUDGET_RESERVE )) ;;
            *) [[ -z "$asking" ]] && asking="$1" ;;
        esac
        shift
    done
    [[ -n "$budget" ]] || budget=$(( DEFAULT_BUDGET - BUDGET_RESERVE ))
    (( budget < 1 )) && budget=1

    while IFS=$'\t' read -r state session label pane project dir title; do
        [[ -n "$pane" ]] || continue
        states+=("$state"); sessions+=("$session")
        projects+=("$project"); titles+=("$title")
        (( ${#project} > longest )) && longest=${#project}
    done < <(stable_rows)
    (( ${#states[@]} )) || return 0

    here="$(configured_colour "$HERE_OPT" "$HERE_DEFAULT")"
    elsewhere="$(configured_colour "$ELSEWHERE_OPT" "$ELSEWHERE_DEFAULT")"
    read -r layout room < <(choose_layout "$budget" "${#states[@]}" "$longest" "$with_folder")

    for i in "${!states[@]}"; do
        if [[ -n "$asking" && "${sessions[$i]}" == "$asking" ]]; then
            style="$here"
        else
            style="$elsewhere"
        fi
        out+="${sep}#[fg=${style}]$(glyph "${states[$i]}") "
        out+="$(describe_agent "${projects[$i]}" "${titles[$i]}" "$layout" "$room")#[default]"
        sep="  "
    done
    printf '%s' "$out"
}

list() {
    local state session label pane project dir title display
    while IFS=$'\t' read -r state session label pane project dir title; do
        [[ -n "$pane" ]] || continue
        printf -v display '%s  %-10s  %-32.32s  %-20.20s  %s' \
            "$(glyph "$state")" "$state" "${title:-$label}" "$session" "${dir/#$HOME/\~}"
        printf '%s\t%s\n' "$display" "$pane"
    done < <(sorted_rows)
}

preview() {  # preview <pane>
    local pane="${1:-}" height
    [[ -n "$pane" ]] || return 0
    have_tmux || return 0

    if [[ "$pane" == !* ]]; then
        printf 'Not running in tmux, so it cannot be shown or jumped to.\n'
        return 0
    fi

    [[ -n "$(tmux display-message -p -t "$pane" '#{pane_id}' 2>/dev/null)" ]] \
        || { echo "pane $pane has gone"; return 0; }

    height="${FZF_PREVIEW_LINES:-40}"
    tmux capture-pane -ep -t "$pane" 2>/dev/null \
        | awk 'NF { for (; blank > 0; blank--) print ""; print; next } { blank++ }' \
        | tail -n "$height"
}

state_file_for_pane() {  # state_file_for_pane <pane>
    local file recorded
    [[ -n "${1:-}" ]] || return 1
    for file in "$STATE_DIR"/*; do
        [[ -f "$file" && "${file##*/}" =~ ^[0-9]+$ ]] || continue
        { read -r _; read -r recorded; } < "$file" 2>/dev/null
        [[ "$recorded" == "$1" ]] && { printf '%s' "$file"; return 0; }
    done
    return 1
}

acknowledge_if_finished() {  # acknowledge_if_finished [pane]
    local pane="${1:-${TMUX_PANE:-}}" file state recorded dir
    [[ -n "$pane" ]] || return 0
    file="$(state_file_for_pane "$pane")" || return 0
    { read -r state; read -r recorded; read -r dir; } < "$file" 2>/dev/null
    [[ "$state" == "done" ]] || return 0
    printf '%s\n%s\n%s\n' idle "$recorded" "$dir" > "$file" 2>/dev/null
    clear_state "$pane"
}

explain_unreachable() {  # explain_unreachable <pane>
    local dir=""
    [[ -r "$STATE_DIR/${1#!}" ]] && { read -r _; read -r _; read -r dir; } < "$STATE_DIR/${1#!}"
    tmux display-message "agent-state: that agent is not running in tmux (${dir:-unknown directory})" 2>/dev/null
    return 0
}

jump() {  # jump <pane>
    local pane="${1:-}" session
    [[ -n "$pane" ]] || return 0
    have_tmux || return 0
    [[ "$pane" == !* ]] && { explain_unreachable "$pane"; return 0; }

    acknowledge_if_finished "$pane"

    session="$(tmux display-message -p -t "$pane" \
        '#{?session_group,#{session_group},#{session_name}}' 2>/dev/null)"
    [[ -n "$session" ]] || return 0

    tmux select-window -t "$pane" 2>/dev/null
    tmux select-pane -t "$pane" 2>/dev/null
    [[ -x "$SESSIONS" ]] || die "required tool not found: tmux-sessions"
    "$SESSIONS" --attach "$session"
}

pick() {
    command -v fzf >/dev/null 2>&1 || die "required tool not found: fzf"
    [[ -n "$(list)" ]] || die "no agent panes found"

    local out pane
    out="$(list | fzf \
        --ansi --delimiter '\t' --with-nth 1 \
        --layout=reverse \
        --prompt 'agent> ' \
        --header 'enter: jump   •   🔐 permission   ❓ question   📝 plan   ✋ waiting   ✅ done   ⏳ working   💤 idle' \
        --preview "$SELF preview {2}" \
        --preview-window 'right,55%,nowrap')"
    [[ -n "$out" ]] || return 0
    pane="$(cut -f2 <<<"$out")"
    jump "$pane"
}

case "${1:-}" in
    set)       set_state "${2:-}" "${3:-}" ;;
    hook)      hook "${2:-}" "${3:-}" ;;
    clear)     clear_state "${2:-}" ;;
    end)       end_hook "${2:-}" ;;
    ack)       acknowledge_if_finished "${2:-}" ;;
    status)    shift; status "$@" ;;
    list)      list ;;
    preview)   preview "${2:-}" ;;
    jump)      jump "${2:-}" ;;
    pick)      pick ;;
    --help|-h) usage ;;
    "")        usage ;;
    *)         die "unknown command: $1 (try --help)" ;;
esac
